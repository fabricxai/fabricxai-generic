# ─────────────────────────────────────────────────────────────────────────────
# FabricXAI — environment. Copy to `.env` and fill in.
# Every key here is validated by Zod at boot (src/lib/env.ts) — the process
# refuses to start and lists everything that is missing or malformed.
# Defaults below match docker-compose.dev.yml, so a fresh clone boots as-is.
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=development
APP_URL=http://localhost:3000

# ── Postgres ────────────────────────────────────────────────────────────────
# App traffic goes through PgBouncer (transaction mode) — Next.js route
# concurrency exhausts raw PG connections (dev-plan §1).
DATABASE_URL=postgres://fabricxai_app_rw:fabricxai-app-dev-secret@localhost:6432/fabricxai
# Migrations and drizzle-kit bypass the pooler: DDL, advisory locks and
# prepared statements do not survive transaction pooling.
DIRECT_DATABASE_URL=postgres://fabricxai:fabricxai@localhost:5433/fabricxai

# ── Redis (BullMQ, rate limits, cached aggregates) ──────────────────────────
REDIS_URL=redis://localhost:6379
WORKER_CONCURRENCY=5

# ── Auth ────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 48
BETTER_AUTH_SECRET=dev-only-secret-change-me-0123456789abcdef
BETTER_AUTH_URL=http://localhost:3000

# ── Object storage (MinIO in dev; any S3 API in prod) ───────────────────────
S3_ENDPOINT=http://localhost:9000
# Browser-facing storage base, used only for signing presigned URLs. Unset in dev,
# where the browser and the server reach MinIO at the same address. In production it
# MUST be set (docker-compose.prod.yml sets it to ${APP_URL}/s3): the server reaches
# MinIO at http://minio:9000, which a floor tablet cannot resolve, and SigV4 signs the
# host so the URL cannot be corrected after the fact.
# S3_PUBLIC_ENDPOINT=https://erp.example.com/s3
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=fabricxai
S3_SECRET_ACCESS_KEY=fabricxai-dev-secret
S3_BUCKET=fabricxai-documents
S3_FORCE_PATH_STYLE=true

# ── MARBIM · the copilot ────────────────────────────────────────────────────
# Whether it is offered at all. Off is the honest setting today: no real model
# provider is registered, so an enabled MARBIM refuses every question.
MARBIM_ENABLED=false
# Serve MARBIM from fixtures instead of calling providers. Dev/test only —
# refused outright when NODE_ENV=production.
MARBIM_MOCK=true

# One vendor per ROLE — never referenced directly from a module, which asks for
# `extract` / `reason` / `embed` and lets the registry route it.
#
#   ANTHROPIC → reason.  Answers questions with the department primers in front of
#               it. REQUIRED in production when MARBIM_ENABLED=true: the assistant
#               button and /marbim do nothing else, so without it the copilot
#               renders perfectly and fails on every question.
#   GEMINI    → extract. Reads documents. The only one of the three returning
#               per-token log-probabilities with a schema-constrained response, and
#               therefore the only one an extraction can derive real per-field
#               confidence from. Optional: without it, intake refuses and says so.
#   OPENAI    → embed.   Style fingerprints for Order Memory's similarity search.
#               Optional: without it, "styles like this one" is unavailable.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=

# The model per role. Defaults are the intended mix; override to change one vendor's
# model without touching code. An extract model that does NOT support responseLogprobs
# makes every extraction fail loudly — by design, since the alternative is a draft
# carrying a confidence nothing measured.
# MARBIM_MODEL_REASON=claude-sonnet-5
# MARBIM_MODEL_REASON_LARGE=claude-opus-4
# MARBIM_MODEL_EXTRACT=gemini-2.5-flash
# MARBIM_MODEL_EMBED=text-embedding-3-small

# ── Health ──────────────────────────────────────────────────────────────────
# /api/health is liveness (public, no detail). /api/ready is dependencies.
# /api/health/jobs names every scheduled task and what is broken, so it needs a
# bearer token — and refuses entirely when this is unset rather than falling open.
#   HEALTH_TOKEN=$(openssl rand -hex 24)
HEALTH_TOKEN=

# ── Email ───────────────────────────────────────────────────────────────────
# Dev: Mailpit (SMTP on 1025, UI on http://localhost:8025).
SMTP_HOST=localhost
SMTP_PORT=1025
EMAIL_FROM=no-reply@fabricxai.local
# Prod: transactional provider only, never self-hosted SMTP.
RESEND_API_KEY=

# ── Observability (required when NODE_ENV=production) ───────────────────────
SENTRY_DSN=
