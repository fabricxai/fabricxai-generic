# FabricXAI — backup credentials. Copy to `.env.backup`, chmod 600, fill in.
#
#   cp .env.backup.example .env.backup && chmod 600 .env.backup
#
# Read by three things:
#   · the `postgres` container   — so archive_command can ship WAL
#   · the `backup` container     — pgBackRest backup / restore / verify
#   · the `docs-sync` container  — rclone MinIO → offsite
#
# WHY THE NAMES LOOK LIKE THIS. pgBackRest does not expand ${VAR} inside its config
# file, so every repository option is passed as an environment variable instead. The
# rule is mechanical: option `repo1-s3-bucket` becomes `PGBACKREST_REPO1_S3_BUCKET`.
# The names below are therefore not ours to shorten — pgBackRest matches them exactly.
#
# ⚠ BACK THIS FILE UP SOMEWHERE THAT SURVIVES THE HOST, and separately from the backups
#   it unlocks. Without PGBACKREST_REPO1_CIPHER_PASS the repository is unreadable
#   ciphertext and there is no recovery from that — not by us, not by the provider.

# ── Postgres repository (pgBackRest) ──────────────────────────────────────────────
#
# Cloudflare R2 shown; Backblaze B2 or any S3 host works. It must be a DIFFERENT
# failure domain from the VPS — not this host's disk, not this deployment's MinIO.
PGBACKREST_REPO1_S3_BUCKET=
# R2: https://<account-id>.r2.cloudflarestorage.com
PGBACKREST_REPO1_S3_ENDPOINT=
# R2 uses the literal string `auto`.
PGBACKREST_REPO1_S3_REGION=auto
PGBACKREST_REPO1_S3_KEY=
PGBACKREST_REPO1_S3_KEY_SECRET=
# GENERATE: openssl rand -base64 48
# Losing this loses every backup. See the warning above.
PGBACKREST_REPO1_CIPHER_PASS=

# ── Document repository (rclone) ──────────────────────────────────────────────────
#
# A SECOND bucket, not the pgBackRest one. Mixing them means a pgBackRest `expire` and
# an rclone `sync --delete` operate on each other's objects, and both are destructive.
RCLONE_CONFIG_DST_TYPE=s3
# `Cloudflare` for R2, `Minio` for MinIO, `AWS` for S3, `B2` for Backblaze. rclone uses
# this to pick which API quirks to work around, so a wrong value fails in odd ways.
RCLONE_CONFIG_DST_PROVIDER=Cloudflare
RCLONE_CONFIG_DST_ENDPOINT=
RCLONE_CONFIG_DST_REGION=auto
RCLONE_CONFIG_DST_ACCESS_KEY_ID=
RCLONE_CONFIG_DST_SECRET_ACCESS_KEY=
# Skip the bucket-exists probe on every run: it needs a permission the sync itself does
# not, so a correctly-scoped write-only token fails without this.
RCLONE_CONFIG_DST_NO_CHECK_BUCKET=true
DOCS_BACKUP_BUCKET=

# ── Bucket protection (Cloudflare R2) ─────────────────────────────────────────────
#
# Bucket locks make the backups undeletable for a window even by something holding the
# S3 credentials above — 14 days for WAL and backup sets, 30 days for displaced document
# versions. `scripts/r2-protect.sh` sets them; run it ONCE from an admin workstation.
#
# ⚠ The token that can REMOVE a lock must never live on this host. That separation is
#   the entire protection: an attacker who reaches the VPS gets the S3 token, which can
#   delete objects but cannot lift the lock that refuses the delete. Put only a
#   READ-ONLY R2 token here, which restore-verify.sh uses to confirm weekly that nobody
#   has quietly removed the rules.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_R2_READ_TOKEN=

# ── Monitoring ────────────────────────────────────────────────────────────────────
#
# All three optional, all three strongly advised. Without them the backup layer is
# working or not working and nobody finds out which until a restore.
#
# HEARTBEAT: pinged on SUCCESS. Point it at a dead-man's-switch (Healthchecks.io,
# Better Stack, Cronitor). This is what catches the failure that no alert can — a timer
# that silently stopped, where nothing runs so nothing ever complains.
BACKUP_HEARTBEAT_URL=
# Separate heartbeat for the 15-minute document sync; a nightly monitor cannot express
# "should have run four times an hour".
DOCS_SYNC_HEARTBEAT_URL=
# ALERT: POSTed a JSON {"text": …} on failure. Whatever on-call actually watches.
# Deliberately NOT the app's own notification path — that needs the database, which is
# the thing that may be broken.
BACKUP_ALERT_URL=
# MONITOR: POSTed the full structured result of the weekly restore verification —
# backup age, WAL lag, restore duration against the 4h RTO, row counts. A heartbeat
# says "it ran"; this says what it found.
BACKUP_MONITOR_URL=
