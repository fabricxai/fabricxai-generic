{
  "name": "fabricxai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "worker:dev": "tsx watch src/worker/index.ts",
    "worker:start": "tsx src/worker/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "db:generate": "drizzle-kit generate",
    "db:generate:custom": "drizzle-kit generate --custom",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:check": "drizzle-kit check",
    "db:studio": "drizzle-kit studio",
    "seed": "tsx src/db/seed/index.ts",
    "demo": "tsx scripts/demo.ts",
    "seed:kit": "tsx scripts/seed-kit-materials.ts",
    "seed:running": "tsx scripts/seed-running-factory.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage && node scripts/coverage-ratchet.mjs",
    "test:browser": "vitest run --config vitest.jsdom.config.ts",
    "test:e2e": "playwright test",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "verify:phase0": "node scripts/verify-phase0.mjs",
    "db:setup-roles": "node scripts/setup-db-roles.mjs",
    "export:tenant": "tsx scripts/export-tenant.ts",
    "payroll:parallel-run": "tsx --env-file=.env scripts/payroll-parallel-run.ts",
    "k6": "tsx --env-file=.env scripts/k6.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.115.0",
    "@aws-sdk/client-s3": "^3.926.0",
    "@aws-sdk/s3-request-presigner": "^3.926.0",
    "@google/genai": "2.16.0",
    "@sentry/nextjs": "^10.69.0",
    "@types/web-push": "^3.6.4",
    "better-auth": "^1.6.25",
    "bullmq": "^5.81.2",
    "dotenv": "^17.2.0",
    "drizzle-orm": "^0.45.2",
    "html-to-image": "^1.11.13",
    "ioredis": "^5.11.1",
    "next": "^16.3.0",
    "nodemailer": "^9.0.3",
    "openai": "7.4.0",
    "pino": "^10.3.1",
    "postgres": "^3.4.9",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tsx": "^4.23.1",
    "web-push": "^3.6.7",
    "zod": "^4.4.3"
  },
  "pnpm": {
    "overrides": {
      "brace-expansion@5": "^5.0.9",
      "esbuild": "^0.28.1",
      "nanoid@3": "^3.3.18"
    }
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/node": "^22.15.0",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "^4.1.10",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.2.12",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.8.0",
    "jsdom": "^30.0.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  }
}
