# Deploys the newest green main build of fabricxai-generic — see autodeploy.sh.
# Installed by ops/vps-platform/install.sh; driven by the .timer next to this file.
[Unit]
Description=FabricXAI platform — deploy newest main image from GHCR
After=docker.service network-online.target
Requires=docker.service

[Service]
Type=oneshot
User=deploy
WorkingDirectory=/opt/fabricxai-platform
ExecStart=/opt/fabricxai-platform/ops/vps-platform/autodeploy.sh
# A deploy (pull + migrate + health wait) comfortably fits; a hung docker pull does not
# get to wedge the timer forever.
TimeoutStartSec=15min
